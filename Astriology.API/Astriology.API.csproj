<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>88694532-d135-4297-90e0-490941a28d7a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Microsoft.AspNetCore.OpenApi 10.0.10 transitively pulls Microsoft.OpenApi 2.0.0,
      which is affected by GHSA-v5pm-xwqc-g5wc (high, patched in 2.7.5).
      This explicit reference overrides the transitive version. Do not remove until
      the ASP.NET Core package ships a dependency on 2.7.5 or later.
      Pinned to the latest stable 2.x: the 3.x line is a different major version and
      is not ABI-compatible with what Microsoft.AspNetCore.OpenApi 10.x builds against.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />

    <!--
      EF Core tooling looks for Microsoft.EntityFrameworkCore.Design in the STARTUP
      project, so it cannot live in Astriology.Infrastructure alongside the DbContext.
      PrivateAssets="all" keeps it design-time only: it is not published, not part of
      the runtime output, and not exposed to projects referencing this one. This is
      the documented exception to keeping EF out of the presentation layer.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.10]" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astriology.Application\Astriology.Application.csproj" />
    <ProjectReference Include="..\Astriology.Infrastructure\Astriology.Infrastructure.csproj" />
  </ItemGroup>

</Project>
