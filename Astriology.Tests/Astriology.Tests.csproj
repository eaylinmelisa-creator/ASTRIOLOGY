<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Bracketed versions are NuGet's exact-match syntax; see the note in
      Astriology.Infrastructure.csproj.

      xunit stays on the 2.x line even though NuGet marks it deprecated ("Legacy",
      alternative xunit.v3). Revisit once the constraint below is gone.

      Microsoft.NET.Test.Sdk stays at the version the SDK template pins; the 18.x
      major moves toward Microsoft.Testing.Platform, which is a separate change to
      make deliberately rather than as a side effect.

      Microsoft.AspNetCore.Mvc.Testing is NOT referenced: it is only useful together
      with a reference to Astriology.API, which this project cannot take - see below.
    -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.14.1]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.5]" />

    <!--
      Reads appsettings.Testing.json. Previously arrived transitively through the
      Astriology.API reference; now that the reference is gone it has to be explicit.
      Pinned to 10.0.10 to stay on the solution's servicing band.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="[10.0.10]" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Astriology.API is deliberately NOT referenced.

      Smart App Control is enabled on the development machine and refuses to load
      Astriology.API.dll into the test host (0x800711C7, "Uygulama Denetimi ilkesi bu
      dosyayı engelledi"). It is an executable assembly, and Smart App Control blocks
      unsigned executables; the three class libraries load without complaint. The
      failure surfaces during type discovery, so referencing the API means zero tests
      run at all - not one test failing, the whole suite.

      Consequence: WebApplicationFactory cannot be used, so HTTP-level behaviour
      (status code mapping, ValidationFilter, middleware, rate limiting) is verified by
      the Swagger smoke tests the roadmap already requires, not automatically. Service
      level logic is still covered through the DI container.

      Turning Smart App Control off is a one-way switch on Windows 11 and was declined.
      Add the reference back if that ever changes.
    -->
    <ProjectReference Include="..\Astriology.Domain\Astriology.Domain.csproj" />
    <ProjectReference Include="..\Astriology.Application\Astriology.Application.csproj" />
    <ProjectReference Include="..\Astriology.Infrastructure\Astriology.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Testing.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
